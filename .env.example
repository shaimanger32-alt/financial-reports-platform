# Copy to .env and fill in real values. .env is git-ignored and never committed.

# --- Database ---------------------------------------------------------------
# Canonical PostgreSQL store. Local development uses the Homebrew server on 5432.
DATABASE_URL=postgresql+psycopg://fri:CHANGE_ME@127.0.0.1:5432/fri_dev

# Separate database used by the test suite. Its contents are disposable.
TEST_DATABASE_URL=postgresql+psycopg://fri:CHANGE_ME@127.0.0.1:5432/fri_test

# Log every SQL statement. Debugging only.
SQL_ECHO=false

# --- API --------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list.
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Providers --------------------------------------------------------------
# MAGNA/XBRL is a public API and needs no credentials today. Kept here so the
# base URL is configuration rather than a constant in the ingestion code.
MAGNA_API_BASE_URL=https://xbrl.magna.isa.gov.il/api
